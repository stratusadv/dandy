{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "stratus"
  ],
  "provider": {
    "stratus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Stratus",
      "options": {
        "baseURL": "{env:AI_API_HOST}:443/v1",
        "apiKey": "{env:AI_API_KEY}"
      },
      "models": {
        "stratus.turbo": {
          "id": "stratus.turbo",
          "name": "Turbo",
          "limit": {
            "context": 48000,
            "output": 16000
          },
          "cost": {
            "input": 1.00,
            "output": 5.00,
            "cache_read": 0,
            "cache_write": 0
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
